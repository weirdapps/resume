# next-env.d.ts is generated by `next build` and says so in its own body
# ("This file should not be edited"). Next writes double-quoted imports;
# prettier rewrites them to single quotes. With both running, every build left
# the tree dirty and every commit flipped the file back, so the two tools
# churned one generated file forever. Prettier yields: Next.js owns it.
resume-modern/next-env.d.ts
